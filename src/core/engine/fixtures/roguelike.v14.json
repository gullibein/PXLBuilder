alue('hp', 0)"}]},{"when":{"on":"tick"},"state":null,"if":"wait > 0","do":[{"do":"set","var":"wait","value":"wait - dt","on":null}]},{"when":{"on":"tick"},"state":null,"if":"not walking_path and wait <= 0","do":[{"do":"set","var":"step_x","value":"pick(key('right'), 1, 0) - pick(key('left'), 1, 0)","on":null},{"do":"set","var":"step_y","value":"step_x != 0 ? 0 : pick(key('down'), 1, 0) - pick(key('up'), 1, 0)","on":null},{"do":"if","cond":"step_x != 0 or step_y != 0","then":[{"do":"set","var":"tx","value":"grid_cell(self.x) + step_x * 32","on":null},{"do":"set","var":"ty","value":"grid_cell(self.y) + step_y * 32","on":null},{"do":"if","cond":"thing_at(tx, ty, foes) != null","then":[{"do":"set_health","target":"thing_at(tx, ty, foes)","value":"thing_at(tx, ty, foes).health - power"},{"do":"popup","text":"-{power}","color":"{damage_color}","on":"thing_at(tx, ty, foes)"},{"do":"set","var":"wait","value":"step_time * 2","on":null},{"do":"signal","name":"world_turn"}],"else":[{"do":"if","cond":"not solid_at(tx, ty)","then":[{"do":"walk_to","x":"tx","y":"ty","steps":"1","speed":"step_speed","on":null},{"do":"set","var":"wait","value":"step_time","on":null},{"do":"signal","name":"world_turn"}],"else":[{"do":"if","cond":"thing_at(tx, ty, door_tag) != null and items(self, key_item) > 0","then":[{"do":"take_item","target":"self","item":"{key_item}","count":"1"},{"do":"set_open","target":"thing_at(tx, ty, door_tag)","open":"true","by":"self"},{"do":"set","var":"wait","value":"step_time","on":null},{"do":"signal","name":"world_turn"}],"else":[{"do":"if","cond":"thing_at(tx, ty, door_tag) != null","then":[{"do":"popup","text":"{locked_text}","color":"#ffffff","on":"thing_at(tx, ty, door_tag)"},{"do":"set","var":"wait","value":"step_time * 3","on":null}],"else":[]}]}]}]}],"else":[]}]},{"when":{"on":"key","key":"interact","edge":"pressed"},"state":null,"if":"not walking_path and wait <= 0","do":[{"do":"set","var":"wait","value":"step_time","on":null},{"do":"signal","name":"world_t